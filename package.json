{
  "name": "sajilo-restaurant",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.ts",
    "dev:lan": "node --watch --env-file=lan.env server.ts",
    "android:assets": "node scripts/sync-mobile-assets.mjs",
    "android:sync": "npm run android:assets && node --require ./scripts/capacitor-shell-fix.cjs ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:debug": "npm run android:sync && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-debug.ps1",
    "android:release": "npm run android:sync && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-release.ps1",
    "cloudflare:assets": "node scripts/sync-cloudflare-assets.mjs",
    "cloudflare:dev": "npm run cloudflare:assets && wrangler dev",
    "cloudflare:deploy": "npm run cloudflare:assets && wrangler deploy",
    "start": "node server.ts",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc && tsc -p tsconfig.worker.json",
    "lint": "prettier --check cloudflare-worker.ts server.ts app.js tests scripts",
    "test:ui": "playwright test",
    "test:load": "node scripts/pos-load-test.mjs",
    "test:db-performance": "node scripts/benchmark-db.mjs",
    "backup:d1": "node scripts/backup-d1.mjs",
    "format": "prettier --write *.ts *.js *.css *.html *.json tests/*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
