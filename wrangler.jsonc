{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sajilo-restaurant",
  "main": "./cloudflare-worker.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./cloudflare-public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sajilo-restaurant",
      "database_id": "3d626431-cbdc-4a15-9514-6ed919a2d1bc",
      "migrations_dir": "./migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RESTAURANT_COORDINATOR",
        "class_name": "RestaurantCoordinator",
      },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RestaurantCoordinator"] },
  ],
  "observability": { "enabled": true },
}
